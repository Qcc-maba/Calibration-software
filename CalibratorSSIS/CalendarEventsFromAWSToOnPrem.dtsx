    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{F3BA8BDE-DCDF-45C4-A3D8-11D62CA81BC8}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="REPLACE(&#xA;    REPLACE(&#xA;        &quot;WITH CalendarEventsList&#xA;AS&#xA;(&#xA;SELECT [CalendarEventId] FROM [dbo].[CalendarEvents] WHERE [CreatedDate] &gt;= '@LoadFromDate' AND [CreatedDate] &lt;= '@LoadToDate'&#xA;UNION&#xA;SELECT [CalendarEventId] FROM [dbo].[CalendarEvents] WHERE [UpdatedDate] &gt;= '@LoadFromDate' AND [UpdatedDate] &lt;= '@LoadToDate'&#xA;)&#xA;&#xA;SELECT ce.[CalendarEventId]&#xA;      ,ce.[Title]&#xA;      ,ce.[StartDate]&#xA;      ,ce.[EndDate]&#xA;      ,ce.[Comments]&#xA;      ,ce.[CreatedDate]&#xA;      ,ce.[UpdatedDate]&#xA;      ,ce.[IsDeleted]&#xA;      ,ce.[UpdateUserID]&#xA;  FROM [dbo].[CalendarEvents] as ce&#xA;  JOIN CalendarEventsList as cel ON ce.[CalendarEventId] = cel.[CalendarEventId] &quot;,&#xA;        &quot;@LoadFromDate&quot;, (DT_WSTR, 30)@[User::LoadFromDate]),&#xA;    &quot;@LoadToDate&quot;, (DT_WSTR, 30)@[$Package::LoadToDate] &#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SourceSQL">
      <DTS:VariableValue
        DTS:DataType="8">WITH CalendarEventsList
AS
(
SELECT [CalendarEventId] FROM [dbo].[CalendarEvents] WHERE [CreatedDate] &gt;= '4/18/2025 3:33:13 PM' AND [CreatedDate] &lt;= '4/18/2025 10:55:00 AM'
UNION
SELECT [CalendarEventId] FROM [dbo].[CalendarEvents] WHERE [UpdatedDate] &gt;= '4/18/2025 3:33:13 PM' AND [UpdatedDate] &lt;= '4/18/2025 10:55:00 AM'
)

SELECT ce.[CalendarEventId]
      ,ce.[Title]
      ,ce.[StartDate]
      ,ce.[EndDate]
      ,ce.[Comments]
      ,ce.[CreatedDate]
      ,ce.[UpdatedDate]
      ,ce.[IsDeleted]
      ,ce.[UpdateUserID]
  FROM [dbo].[CalendarEvents] as ce
  JOIN CalendarEventsList as cel ON ce.[CalendarEventId] = cel.[CalendarEventId] </DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
