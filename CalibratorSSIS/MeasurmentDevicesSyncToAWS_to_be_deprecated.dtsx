                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
       ic.RangeStart as [Value1]
      ,ic.RangeStop as [Value2]
      ,ic.[Note]
      ,ic.InstrumentId as [MeasurementDevicesId]
      ,ic.[MeasurementId]
      ,ic.[UnitID]
      ,ic.[CorVersion]
      ,d.DepartmentHeb as [Department]
      ,ic.[Value] as [Equation]
      ,ic.[ID]as [MeasurementDevicesCorrectionsSourceId]
  FROM [kyulan].[dbo].[tblInstrCorrections] as ic
  LEFT JOIN [kyulan].[dbo].tblDepartments as d ON ic.Department = d.ID</property>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">30</property>
