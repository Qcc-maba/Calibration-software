                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH cte
as
(
SELECT
	p.ID,	
	p.Instrument,	
	p.Parent,
	ROW_NUMBER() OVER( PARTITION BY p.Instrument,p.Parent ORDER BY p.ID) as rn
FROM [kyulan].[dbo].[tblParentInstr] as p
)
SELECT ID,Instrument,Parent FROM cte
WHERE rn= 1</property>
