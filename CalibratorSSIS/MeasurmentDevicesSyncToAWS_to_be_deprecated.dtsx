                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT i.[ID] as [MeasurementDeviceSourceId]
      ,i.[MabaID]
      ,i.[Description]
      ,i.Manufacturer as [ManufacturerId]
      ,i.[Model]
      ,i.[SerialNumber]
      ,i.[NextCalibration]
      ,i.[Note]
      ,i.Calibrated as [CalibrationDate]
      ,i.[Measurement] as [MeasurementId]
      ,i.[MainClass] as [MainClassId]
      ,i.[SubClass] as [SubClassId]
      ,i.[ExtraCalTools]
      ,d.[DepartmentHeb] as [Department]
      ,i.[Unit] as [UnitId]
      ,i.CalibPerson as [CalibratorId]
      ,i.[ReportNumber]
      ,i.[WorkRangeUnit] as [WorkRangeUnitId]
      ,i.[WorkRangeMin]
      ,i.[WorkRangeMax]
      ,i.[DefaultPrecision]
      ,i.[HighestPrecision]
      ,i.[Added] as [CreateDate]
      ,i.Removed as [RemoveDate]
      ,i.[AllowMinOOR]
      ,i.[AllowMaxOOR]
  FROM [kyulan].[dbo].[tblInstr] as i
  JOIN [kyulan].[dbo].tblDepartments as d ON i.Department = d.ID</property>
