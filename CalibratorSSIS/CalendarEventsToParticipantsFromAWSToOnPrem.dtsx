    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{11648269-D455-47F3-B9C9-84697E911110}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="REPLACE(&#xA;    REPLACE(&#xA;        &quot;SELECT cpt.[CalendarEventId]&#xA;      ,cpt.[UserId]&#xA;      ,cpt.[CreatedDate]&#xA;      ,cpt.[UpdatedDate]&#xA;      ,cpt.[IsDeleted]&#xA;      ,cpt.[UpdateUserID]&#xA;  FROM [dbo].[CalendarEventsToParticipants] as cpt&#xA;  WHERE &#xA;  (cpt.[CreatedDate] &gt;= '@LoadFromDate' AND cpt.[CreatedDate] &lt;= '@LoadToDate')&#xA;  OR&#xA;  (cpt.[UpdatedDate] &gt;= '@LoadFromDate' AND cpt.[UpdatedDate] &lt;= '@LoadToDate') &quot;,&#xA;        &quot;@LoadFromDate&quot;, (DT_WSTR, 30)@[User::LoadFromDate]),&#xA;    &quot;@LoadToDate&quot;, (DT_WSTR, 30)@[$Package::LoadToDate] &#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SourceSQL">
      <DTS:VariableValue
        DTS:DataType="8">SELECT cpt.[CalendarEventId]
      ,cpt.[UserId]
      ,cpt.[CreatedDate]
      ,cpt.[UpdatedDate]
      ,cpt.[IsDeleted]
      ,cpt.[UpdateUserID]
  FROM [dbo].[CalendarEventsToParticipants] as cpt
  WHERE 
  (cpt.[CreatedDate] &gt;= '4/18/2025 3:33:13 PM' AND cpt.[CreatedDate] &lt;= '4/18/2025 10:55:00 AM')
  OR
  (cpt.[UpdatedDate] &gt;= '4/18/2025 3:33:13 PM' AND cpt.[UpdatedDate] &lt;= '4/18/2025 10:55:00 AM') </DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
