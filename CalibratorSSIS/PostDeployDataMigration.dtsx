            <SQLTask:SqlTaskData
              SQLTask:Connection="{5D340525-F86F-4A09-8F4F-C17373323AB0}"
              SQLTask:SqlStatementSource="&#xA;SELECT TOP 1 @CarStatusId = s.StatusId &#xA;  FROM [Calibrator].[dbo].[Statuses] as s&#xA;  JOIN [Calibrator].[dbo].[StatusesCategories] as sc ON s.StatusCategoryId = sc.StatusCategoryId&#xA;  WHERE s.StatusDescriptionENG = 'Available' AND sc.StatusDescriptionENG = 'CarStatus'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="@CarStatusId "
                SQLTask:DtsVariableName="User::CarStatus"
                SQLTask:ParameterDirection="Output"
                SQLTask:DataType="11"
                SQLTask:ParameterSize="-1" />
