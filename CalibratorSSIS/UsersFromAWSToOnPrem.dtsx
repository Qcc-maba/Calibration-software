    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{5B86CD45-9472-4470-AABB-93E63FD02C74}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="REPLACE(&#xA;    REPLACE(&#xA;        &quot;WITH UserList&#xA;as&#xA;(&#xA;SELECT [ID] FROM [dbo].[Users] WHERE [CreatedDate] &gt;= '@LoadFromDate' AND [CreatedDate] &lt;= '@LoadToDate'&#xA;UNION&#xA;SELECT [ID] FROM [dbo].[Users]WHERE [UpdatedDate] &gt;= '@LoadFromDate' AND [UpdatedDate] &lt;= '@LoadToDate'&#xA;)&#xA;SELECT u.[ID]&#xA;      ,u.[FirstName]&#xA;      ,u.[LastName]&#xA;      ,u.[FirstNameEng]&#xA;      ,u.[LastNameEng]&#xA;      ,u.[Email]&#xA;      ,u.[Password]&#xA;      ,u.[Phone]&#xA;      ,u.[IsActive]&#xA;      ,u.[CreatedDate]&#xA;      ,u.[UpdatedDate]&#xA;      ,u.[UpdateUserID]&#xA;      ,u.[UserAddress]&#xA;      ,u.[LocationArea]&#xA;      ,u.[Stamp]&#xA;  FROM [dbo].[Users] as u&#xA;  JOIN UserList as ul ON u.ID = ul.ID &quot;,&#xA;        &quot;@LoadFromDate&quot;, (DT_WSTR, 30)@[User::LoadFromDate]),&#xA;    &quot;@LoadToDate&quot;, (DT_WSTR, 30)@[$Package::LoadToDate] &#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SourceSQL">
      <DTS:VariableValue
        DTS:DataType="8">WITH UserList
as
(
SELECT [ID] FROM [dbo].[Users] WHERE [CreatedDate] &gt;= '4/18/2025 3:33:13 PM' AND [CreatedDate] &lt;= '4/18/2025 10:55:00 AM'
UNION
SELECT [ID] FROM [dbo].[Users]WHERE [UpdatedDate] &gt;= '4/18/2025 3:33:13 PM' AND [UpdatedDate] &lt;= '4/18/2025 10:55:00 AM'
)
SELECT u.[ID]
      ,u.[FirstName]
      ,u.[LastName]
      ,u.[FirstNameEng]
      ,u.[LastNameEng]
      ,u.[Email]
      ,u.[Password]
      ,u.[Phone]
      ,u.[IsActive]
      ,u.[CreatedDate]
      ,u.[UpdatedDate]
      ,u.[UpdateUserID]
      ,u.[UserAddress]
      ,u.[LocationArea]
      ,u.[Stamp]
  FROM [dbo].[Users] as u
  JOIN UserList as ul ON u.ID = ul.ID </DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
