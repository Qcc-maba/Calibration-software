      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{76ED0EFD-E8C5-4864-8512-E3A776A40A48}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT 1 FROM etl.ETLExecutionLog WHERE ETLPackageName = @PackageName)&#xA;INSERT etl.ETLExecutionLog(ETLPackageName,LastExecutionDate)&#xA;VALUES(@PackageName,'1900-01-01')&#xA;&#xA;SELECT @LoadToDate=LastExecutionDate&#xA;FROM etl.ETLExecutionLog&#xA;WHERE ETLPackageName = @PackageName" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="@LoadToDate"
            SQLTask:DtsVariableName="User::LoadFromDate"
            SQLTask:ParameterDirection="Output"
            SQLTask:DataType="26"
            SQLTask:ParameterSize="-1" />
