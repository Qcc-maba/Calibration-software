    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    public override void CreateNewOutputRows()
    {
        try
        {
            byte[] stringAsBytes = Encoding.Unicode.GetBytes(System.IO.File.ReadAllText(Variables.FullFilePath));
            Output0Buffer.AddRow();
            Output0Buffer.CustomerRemark.AddBlobData(stringAsBytes);
        }
        catch (Exception ex)
        {
            // Handle any exceptions (e.g., log errors or stop processing).
            throw new ApplicationException($"Error reading file: {ex.Message}");
        }
    }

}
