                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	c.CUST as CustomerID,
	c.CUSTDES as CustomerName,
	c.PHONE as CustomerPhone,
	REVERSE(c.STATE) as CustomerCity,
	REVERSE(c.ADDRESS) as CustomerAddress,
	'MABA' as SourceSystem
FROM amaba.dbo.CUSTOMERS as c
UNION ALL
SELECT 
	c.CUST as CustomerID,
	c.CUSTDES as CustomerName,
	c.PHONE as CustomerPhone,
	REVERSE(c.STATE) as CustomerCity,
	REVERSE(c.ADDRESS) as CustomerAddress,
	'SEPHARM' as SourceSystem
FROM sepharm.dbo.CUSTOMERS as c</property>
