                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT [OrderNumber]
      ,[OpenDate]
      ,[CustomerID]
      ,SUBSTRING([CustomerName],1,100) AS [CustomerName]
      ,[CustomerPhone]
      ,[CustomerContactName]
      ,SUBSTRING([CustomerCity],1,100) AS [CustomerCity]
      ,SUBSTRING([CustomerAddress],1,100) AS [CustomerAddress]
      ,[CustomerContactPhone]
      ,[MBAContactName]
      ,[MBAContactPhone]
      ,[MBAContactMobile]
      ,NULL AS [ClientRemarks]
      ,[MbaReportNumber]
      ,[Serial Number] as [SerialNumber]
      ,[Manufacturer Number] as [ManufacturerNumber]
      ,[Device Description] as [DeviceDescription]
      ,[Device model] as [Devicemodel]
      ,[CalibDate]
      ,[NextCalibDate]
      ,[CALIBMONTH]
      ,[ReturnDate]
      ,[Part Name] as [PartName]
      ,[Part Description] as [PartDescription]
      ,[InHouse]
      ,[DepartmentCode]
      ,[DepartmentName]
      ,[StatusCode]
      ,[CalibStatud]
      ,SUBSTRING([Device manufacturer],1,50) as [DeviceManufacturer]
      ,[PART]
      ,[Klita]
      ,[CustomerContactPersonRole]
      ,[CustomerContactAdditionalPhoneNumber]
      ,[CustomerContactEmail]
	  ,'amaba' as src
  FROM [dbo].[vwGetOrders_WorkPlan_Full]
  WHERE [OpenDate] &gt; DATEADD(DAY,-7,GETDATE())
UNION ALL
SELECT [OrderNumber]
      ,[OpenDate]
      ,[CustomerID]
