            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Populate staging tables\Load data to stg_Customers\Get source data"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="Get source data"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	c.CUST as CustomerID,
	SUBSTRING(system.dbo.tabula_hebconvert(c.CUSTDES),1,48) as CustomerName,
	c.PHONE as CustomerPhone,
	SUBSTRING(system.dbo.tabula_hebconvert(c.STATE),1,40) as CustomerCity,
	SUBSTRING(system.dbo.tabula_hebconvert(c.ADDRESS),1,80) as CustomerAddress,
	SUBSTRING(system.dbo.tabula_hebconvert(st.STDES),1,50) as ShipTypeDescr,
	TRY_CAST(c.MBA_SIGNAMOUNT AS TINYINT) as SignatureAmount,
    SUBSTRING(system.dbo.tabula_hebconvert(IIF(LEN(sp.[SPEC7]) &gt;=2,sp.[SPEC7],N'יש לשלוח את הדו״ח ללקוח')),1,50) as ReportRequired,   
	'MABA' as SourceSystem
FROM amaba.dbo.CUSTOMERS as c
LEFT JOIN amaba.dbo.CUSTSPEC as sp ON c.CUST = sp.CUST
LEFT JOIN amaba.[dbo].[SHIPTYPES] as st ON c.SHIPTYPE = st.SHIPTYPE
WHERE c.CUST &gt; 0
UNION ALL
SELECT 
	c.CUST as CustomerID,
	SUBSTRING(system.dbo.tabula_hebconvert(c.CUSTDES),1,48) as CustomerName,
	c.PHONE as CustomerPhone,
	SUBSTRING(system.dbo.tabula_hebconvert(c.STATE),1,40) as CustomerCity,
	SUBSTRING(system.dbo.tabula_hebconvert(c.ADDRESS),1,80) as CustomerAddress,
	SUBSTRING(system.dbo.tabula_hebconvert(st.STDES),1,50) as ShipTypeDescr,
	TRY_CAST(c.MBA_SIGNAMOUNT AS TINYINT) as SignatureAmount,
    SUBSTRING(system.dbo.tabula_hebconvert(IIF(LEN(sp.[SPEC7]) &gt;=2,sp.[SPEC7],N'יש לשלוח את הדו״ח ללקוח')),1,50) as ReportRequired,  
	'SEPHARM' as SourceSystem
FROM sepharm.dbo.CUSTOMERS as c
LEFT JOIN sepharm.dbo.CUSTSPEC as sp ON c.CUST = sp.CUST
LEFT JOIN sepharm.[dbo].[SHIPTYPES] as st ON c.SHIPTYPE = st.SHIPTYPE
WHERE c.CUST &gt; 0</property>
                    <property
