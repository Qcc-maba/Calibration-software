                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT [SourceOrderId]
      ,[KLINE]
      ,[SERN]
      ,[ORDNAME]
      ,[OpenDate]
      ,[CalibDate]
      ,[CustomerSourceId]
      ,[SerialNumber]
      ,[ManufacturerNumber]
      ,SUBSTRING([Devicemodel],1,30) as [Devicemodel]
      ,[SpecialCareTypeId]
      ,[InHouse]
      ,SUBSTRING([MainCategorySourceId],1,50) as [MainCategorySourceId]
      ,SUBSTRING([SecondCategorySourceId],1,48) as [SecondCategorySourceId]
      ,[PART]
      ,[PartName]
      ,SUBSTRING([DeviceType],1,59) as [DeviceType]
      ,[MbaReportNumber]
      ,[DeviceManufacturerSourceId]
      ,[OrderLineCnt]
	  ,[VPRICE]
	  ,[PRICE]
	  ,SUBSTRING([ProductLocation],1,50) as [ProductLocation]
	  ,'MABA' as SourceSystem
	  ,[ORDSTATUS]
	  ,[CustomerPackingExists]
	  ,[ActualReturnDate]
	  ,[ExpectedReturnDate]
	  ,SUBSTRING([PackageLocation],1,50) as [PackageLocation]
      ,[OrderDetailId]
      ,SUBSTRING([ShipTypeDesc],1,50) as [ShipTypeDesc]
  FROM [amaba].[dbo].[vwGetOrders_WorkPlan_Full_new]
UNION ALL
