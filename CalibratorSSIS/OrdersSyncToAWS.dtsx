                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	 d.DEPTDES as OrdersMainCategoryName
	,d.DEPT as OrdersMainCategoryIdFromSource
	,'MABA' as SourceSystem
FROM amaba.dbo.DEPT as d
UNION ALL
SELECT 
	 d.DEPTDES as OrdersMainCategoryName
	,d.DEPT as OrdersMainCategoryIdFromSource
	,'SEPHARM' as SourceSystem
FROM sepharm.dbo.DEPT as d</property>
