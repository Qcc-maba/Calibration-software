    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{E6623B48-18FD-4214-9DBE-8BCF89AFC44C}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT&#xA;     icr.[ID] as MeasurementDevicesCorrectionsSourceId&#xA;    ,icr.[RangeStart]&#xA;    ,icr.[RangeStop]&#xA;    ,icr.[Value]&#xA;    ,icr.[DateAdded]&#xA;    ,icr.[CorVersion]&#xA;&#x9;,i.[MabaID]&#xA;&#x9;,m.NameEn as [MeasurementNameEn]&#xA;&#x9;,m.NameHe as [MeasurementNameHe]&#xA;&#x9;,u.ShortNameEn as [ShortNameEn]&#xA;&#x9;,u.LongNameEn as [LongNameEn] &#xA;&#x9;,u.ShortNameHe as [ShortNameHe]&#xA;&#x9;,u.LongNameHe as [LongNameHe] &#xA;&#x9;,d.DepartmentHeb &#xA;FROM [kyulan].[dbo].[tblInstrCorrections] as icr&#xA;JOIN [kyulan].[dbo].[tblInstr] as i ON icr.[InstrumentId] = i.[ID]&#xA;JOIN [kyulan].[dbo].[tblMeasurements] as m ON icr.[MeasurementId] = m.[ID]&#xA;JOIN [kyulan].[dbo].[tblUnits] as u ON icr.[UnitID] = u.[ID]&#xA;JOIN [kyulan].[dbo].[tblDepartments] as d ON icr.[Department] = d.[ID]&#xA;WHERE icr.[DateAdded] &gt;='&quot; +  (DT_STR, 50, 1251) @[User::MeasurementDevicesCorrectionsDate]+&quot;'&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="MeasurementDevicesCorrectionsSQL">
      <DTS:VariableValue
        DTS:DataType="8">SELECT
     icr.[ID] as MeasurementDevicesCorrectionsSourceId
    ,icr.[RangeStart]
    ,icr.[RangeStop]
    ,icr.[Value]
    ,icr.[DateAdded]
    ,icr.[CorVersion]
	,i.[MabaID]
	,m.NameEn as [MeasurementNameEn]
	,m.NameHe as [MeasurementNameHe]
	,u.ShortNameEn as [ShortNameEn]
	,u.LongNameEn as [LongNameEn] 
	,u.ShortNameHe as [ShortNameHe]
	,u.LongNameHe as [LongNameHe] 
	,d.DepartmentHeb 
FROM [kyulan].[dbo].[tblInstrCorrections] as icr
JOIN [kyulan].[dbo].[tblInstr] as i ON icr.[InstrumentId] = i.[ID]
JOIN [kyulan].[dbo].[tblMeasurements] as m ON icr.[MeasurementId] = m.[ID]
JOIN [kyulan].[dbo].[tblUnits] as u ON icr.[UnitID] = u.[ID]
JOIN [kyulan].[dbo].[tblDepartments] as d ON icr.[Department] = d.[ID]
WHERE icr.[DateAdded] &gt;='12/14/1900 3:14:00 PM'</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
