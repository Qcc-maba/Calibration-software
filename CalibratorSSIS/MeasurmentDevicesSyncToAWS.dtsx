                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT m.[ID] as [MeasurementIdFromSource]
      ,m.[NameEn]
      ,m.[NameHe]
      ,m.[NoteEn]
      ,m.[NoteHe]
      ,d.DepartmentHeb as [Department]
  FROM [kyulan].[dbo].[tblMeasurements] as m
  JOIN [kyulan].[dbo].tblDepartments as d ON m.Department = d.ID</property>
