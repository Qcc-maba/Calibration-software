    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{8F2489F4-0101-42E9-93F0-DB6CA3BD9EAC}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="REPLACE(&#xA;    REPLACE(&#xA;        &quot;DROP TABLE IF EXISTS #CarList&#xA;CREATE TABLE #CarList&#xA;(&#xA;    [CarId] INT&#xA;)&#xA;INSERT #CarList([CarId])&#xA;SELECT [CarId] FROM [dbo].[Cars] WHERE [CreateDate] &gt;= '@LoadFromDate' AND [CreateDate] &lt;= '@LoadToDate'&#xA;UNION &#xA;SELECT [CarId] FROM [dbo].[Cars] WHERE [UpdatedDate] &gt;= '@LoadFromDate' AND [UpdatedDate] &lt;= '@LoadToDate'&#xA;&#xA;SELECT c.[CarId],&#xA;       c.[MabaNumber],&#xA;       c.[Model],&#xA;       c.[LicenseNumber],&#xA;       c.[Seats],&#xA;       c.[TreatmentPeriod],&#xA;       c.[NextTreatmentDate],&#xA;       c.[NextYearlyTestDate],&#xA;       c.[OwnerId],&#xA;       c.[CarStatusId],&#xA;       c.[CreateDate],&#xA;       c.[UpdatedDate],&#xA;       c.[AssignedCalibratorId],&#xA;       c.[UpdateUserID],&#xA;       c.[IsDeleted]&#xA;FROM [dbo].[Cars] AS c&#xA;JOIN #CarList AS cl ON c.CarId = cl.CarId&quot;,&#xA;        &quot;@LoadFromDate&quot;, (DT_WSTR, 30)@[User::LoadFromDate]),&#xA;    &quot;@LoadToDate&quot;, (DT_WSTR, 30)@[$Package::LoadToDate] &#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SourceSQL">
      <DTS:VariableValue
        DTS:DataType="8">DROP TABLE IF EXISTS #CarList
CREATE TABLE #CarList
(
    [CarId] INT
)
INSERT #CarList([CarId])
SELECT [CarId] FROM [dbo].[Cars] WHERE [CreateDate] &gt;= '4/18/2025 3:33:13 PM' AND [CreateDate] &lt;= '4/18/2025 10:55:00 AM'
UNION 
SELECT [CarId] FROM [dbo].[Cars] WHERE [UpdatedDate] &gt;= '4/18/2025 3:33:13 PM' AND [UpdatedDate] &lt;= '4/18/2025 10:55:00 AM'

SELECT c.[CarId],
       c.[MabaNumber],
       c.[Model],
       c.[LicenseNumber],
       c.[Seats],
       c.[TreatmentPeriod],
       c.[NextTreatmentDate],
       c.[NextYearlyTestDate],
       c.[OwnerId],
       c.[CarStatusId],
       c.[CreateDate],
       c.[UpdatedDate],
       c.[AssignedCalibratorId],
       c.[UpdateUserID],
       c.[IsDeleted]
FROM [dbo].[Cars] AS c
JOIN #CarList AS cl ON c.CarId = cl.CarId</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
