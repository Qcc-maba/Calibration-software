# ═══════════════════════════════════════════════════════════════════════════════════════════════
#  Calibration-software — UNIFIED ENVIRONMENT (single source of truth)
# ═══════════════════════════════════════════════════════════════════════════════════════════════
#  Copy this file to `.env` (which is gitignored) and fill in the *** placeholders.
#  Each subsystem reads only the section(s) it needs — the mapping is noted per section.
#  NEVER commit the filled `.env`. Secrets marked  <<SECRET>>  must not be shared/committed.
#
#  Subsystems:
#    A) Client Analyzer   (customer-analysis/, Node)      -> reads via dotenv  (customer-analysis/.env)
#    B) Instruction Asst. (Systems/InstructionAssistant/) -> env vars / appsettings.Development.json
#    C) VCT server + 9100 (Systems/…/ComServer)           -> runtime Settings/*.json (values below)
#    D) Priority / DBA    (Systems/Priority, DBA/)         -> SQL Server + OData
#    E) Calibrator DB     (shared APP <-> C# link)         -> app/.env REMOTE_DATABASE_URL_*
# ═══════════════════════════════════════════════════════════════════════════════════════════════


# ── A) CLIENT ANALYZER  (customer-analysis — Node/Express + Drizzle) ─────────────────────────────
# Local PostgreSQL 16 (Windows service postgresql-x64-16). qcc_analytics = real data (deployed
# service QCCAnalytics); customer_analysis = the empty DB created during bring-up.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qcc_analytics
NODE_ENV=development
PORT=5000
# Optional live-sync trigger endpoint
PRODUCTION_URL=
SYNC_SECRET=


# ── B) INSTRUCTION ASSISTANT  (Systems/InstructionAssistant — net10 service) ─────────────────────
# Env-var form uses the ASP.NET Core "__" nesting; or fill appsettings.Development.json instead.
# The real network paths are already committed in the service's appsettings.json — override only
# if the share moves or another customer's folder is added.
InstructionAssistant__CentralExcel__Path=\\maba-dc\Public\הספריה הציבורית\ECS לומניס בוסטון\אקסל מרכז. ECS.xlsx
InstructionAssistant__FileShare__Roots__0=\\maba-dc\Public\הספריה הציבורית\ECS לומניס בוסטון
InstructionAssistant__Summarizer__Mode=Claude
InstructionAssistant__Summarizer__Model=claude-sonnet-5
# Reads "הנחיות לביצוע" from amaba.dbo.ORDERSTEXT — read-only login is enough.
InstructionAssistant__Priority__Enabled=true
InstructionAssistant__Priority__ConnectionString=Server=maba-priority\pri;Database=amaba;User Id=***;Password=***;TrustServerCertificate=True;Encrypt=False   # <<SECRET>>
# Claude API key — env wins over appsettings.  <<SECRET>>
ANTHROPIC_API_KEY=***


# ── C) VCT SERVER + DATRON 9100 (GPIB)  (Systems/…/ComServer) ────────────────────────────────────
# These live in the runtime Settings/VCT.json + ComServerSettings.json (patched during bring-up).
# Recorded here as the single reference; the host must run as x86 (gpib-32.dll is 32-bit/__cdecl).
VCT_WEBSOCKET_LISTEN_PREFIX=http://localhost:5001/ws/
DATRON9100_GPIB_PRIMARY_ADDRESS=18
DATRON9100_GPIB_BOARD_INDEX=0


# ── D) PRIORITY ERP  (Systems/Priority OData + DBA SQL Server sync) ───────────────────────────────
# Priority OData (REST). PAT preferred; else on-prem user/pass.
PRIORITY_ODATA_BASEURL=https://server/odata/Priority/tabula.ini/company
PRIORITY_ODATA_TOKEN=***                     # <<SECRET>>  (Basic-Auth as {TOKEN}:PAT)
# Priority SQL Server (used by the Python sync scripts). ROTATE — these leaked once.
SQL_SERVER_ADDR=maba-priority\pri
SQL_DATABASE=amaba
SQL_UID=kyulan
SQL_PWD=***                                  # <<SECRET>>  ROTATE
SSIS_PROJECT_PASSWORD=***                     # <<SECRET>>  (12 .dtsx packages; was "abam")


# ── E) CALIBRATOR DB  (shared link between the APP (Next.js) and the C# server) ───────────────────
# AWS SQL Server. STAGE = Calibrator, PROD = CalibratorProd. Prisma "sqlserver://" URL form.
# (These are the app/.env REMOTE_DATABASE_URL_* — the DBA step-0 investigation reads STAGE, read-only.)
CALIBRATOR_DB_HOST=51.17.121.203
CALIBRATOR_DB_STAGE=Calibrator
CALIBRATOR_DB_PROD=CalibratorProd
CALIBRATOR_DB_STAGE_USER=app_stage
CALIBRATOR_DB_PROD_USER=app_prod
CALIBRATOR_DB_PASSWORD=***                    # <<SECRET>>  ROTATE (passed via insecure channels)


# ── F) SHIP / UPS API  (customer-analysis live shipment sync) ────────────────────────────────────
# ROTATE — leaked once. eliran_ha@mba.co.il / (old pw Eliran8hadad).
SHIP_API_EMAIL=eliran_ha@mba.co.il
SHIP_API_PASSWORD=***                         # <<SECRET>>  ROTATE
SHIP_CUSTOMER_ID=


# ── G) AWS / S3  (APP asset storage) ─────────────────────────────────────────────────────────────
AWS_REGION=il-central-1
S3_BUCKET_NAME=calibrationsoftware
AWS_ACCESS_KEY_ID=***                         # <<SECRET>>
AWS_SECRET_ACCESS_KEY=***                     # <<SECRET>>
