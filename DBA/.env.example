# DBA local environment — template.
# Copy this file to DBA/.env (which is gitignored) and fill in the real values.
# NEVER commit DBA/.env — it holds paths and secrets.

# --- SSIS source (blocker #2) ---
# Absolute path to the local clone of Qcc-maba/app that contains the 12 SSIS (.dtsx) packages.
QCC_APP_CLONE_PATH=

# SSIS project protection password (fill locally in DBA/.env; never put the real value in git).
SSIS_PROJECT_PASSWORD=

# --- Local Docker test SQL Server (DBA/docker) ---
MSSQL_SA_PASSWORD=

# --- Production/source connections (read-only investigation, step 0) ---
# amaba (Priority ERP, on-prem SQL 2019) and CalibratorProd (AWS, SQL 2022).
AMABA_CONN=
CALIBRATOR_PROD_CONN=
