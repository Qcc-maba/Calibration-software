<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <!-- A1 is set to be a ConsoleAppender -->
  <appender name="A199" type="log4net.Appender.ColoredConsoleAppender">

    <!-- A1 uses PatternLayout -->
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%-4timestamp [%thread] %-5level %logger %ndc - %message%newline" />
    </layout>
  </appender>
  <!--<appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="App_Data//Logs//Server_logfile_.log" />
    <appendToFile value="true" />    
    <rollingStyle value="Composite" />
    <datePattern value="yyyyMMdd" />
    <maxSizeRollBackups value="14" />
    <maximumFileSize value="5KB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="SERVER :: %date [%thread] %-5level %logger [%property{MyGlobalProperty}] - %message%newline" />
    </layout>
  </appender>-->
  <!-- Set root logger level to DEBUG and its only appender to A1 -->
  <root>
    <level value="ALL" />
    <appender-ref ref="A199" />
  </root>
</log4net>
