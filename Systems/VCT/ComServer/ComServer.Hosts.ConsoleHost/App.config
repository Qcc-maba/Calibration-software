<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <appSettings>
    <!-- Same email as web login: ComServer loads COM/baud from GetLogersConfiguredByCalibrator on startup. -->
    <add key="CalibratorUserEmail" value="" />
    <!-- Set to true to keep serial settings from VCT.json only. -->
    <add key="SkipCalibratorLoggerFromDatabase" value="false" />
  </appSettings>
  <connectionStrings>
    <!-- VCT.json מבקש "KyulanSyncDB" (VCTSettings.GeneralDBName), ובכוונה אין כאן ערך כזה:
         ResolveDbSectionName מעדיף אותו על פני REMOTE_DATABASE_URL, ולכן הוספת ערך
         KyulanSyncDB *מנתבת מחדש את כל התחנה*.

         אל תוסיף אותו כדי "להשלים את החסר". כל ההגדרות ההיסטוריות שלו מצביעות על
         Database=Calibrator ב-Maba-priority\PRI - עותק שקפא ב-17/03/2025, בסכימה ישנה
         ושטוחה שחסרות בה OrderDetails, OrderWorkPlans ו-AssignMeasurmentDevicesToCalibrator
         שהשרת קורא להן. גם kyulan באותו שרת אינו מתאים: הוא חי ומעודכן אבל בסכימת
         MABA2000 (tblInstr), בלי אף אחת מהטבלאות האלה.

         פיצול כייל פנים/חוץ בין שרת מקומי לגלובלי טרם מומש בשום שכבה -
         ראה docs/internal-external-calibrator-split.md לפני שינוי כאן. -->
    <add name="REMOTE_DATABASE_URL" connectionString="Server=51.17.121.203;Database=Calibrator;User Id=app_stage;Password=B52_as113s@;Encrypt=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <runtime>
    <!-- Surface faulted tasks nobody awaited instead of letting the finalizer swallow them.
         Paired with the TaskScheduler.UnobservedTaskException handler in Program.cs, which marks
         them observed after logging - so this makes them visible without making them fatal. -->
    <ThrowUnobservedTaskExceptions enabled="true" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
