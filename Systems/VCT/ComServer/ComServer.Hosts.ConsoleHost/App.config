<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <appSettings>
    <!-- Same email as web login: ComServer loads COM/baud from GetLogersConfiguredByCalibrator on startup. -->
