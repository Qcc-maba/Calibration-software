<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Maba.VCT.Core]*</Include>
          <!-- Compiler-generated closure types (lambdas) skew branch metrics; real logic stays in ServerCore -->
          <Exclude>[Maba.VCT.Core]*c__DisplayClass*</Exclude>
          <ExcludeByAttribute>ExcludeFromCodeCoverage</ExcludeByAttribute>
          <Threshold>95</Threshold>
          <ThresholdType>line,branch</ThresholdType>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
