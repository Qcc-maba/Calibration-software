<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<!--
		No connectionStrings here on purpose.

		This block used to carry three live credentials - a SQL Server login against
		CalibratorProd, and a MySQL root password - and it was committed, so they were
		readable by anyone with the repo and the test suite pointed at PRODUCTION.

		Nothing in VCT.Core.Tests opens a database: no test references ConnectionStrings,
		SqlConnection or MSSqlServer. The block was dead weight that only carried risk.

		If a test ever does need a database, give it a connection through an environment
		variable and point it at a throwaway schema. Never at CalibratorProd.
	-->
	<connectionStrings>
		<!-- Deliberately unreachable. The BL builds a CalibrationRepository on construction and
		     needs the ENTRY to exist; it does not need it to connect. Pointing it at a server that
		     cannot be reached is what keeps a stray unit test from touching a real database. -->
		<add name="REMOTE_DATABASE_URL" connectionString="Server=(local)\NONEXISTENT;Database=UnitTests;Integrated Security=True;Connect Timeout=1;" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="Device_7E_port" value="50000" />
	</appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
