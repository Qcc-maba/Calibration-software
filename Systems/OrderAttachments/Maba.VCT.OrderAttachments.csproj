<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Maba.VCT.OrderAttachments</RootNamespace>
    <AssemblyName>Maba.VCT.OrderAttachments</AssemblyName>
    <!-- MBA-930. Serves the documents Priority hangs off an order to the calibrator, converted
         to PDF. Standalone net10 web service, same deployment pattern as
         Maba.VCT.InstructionAssistant. -->
  </PropertyGroup>

  <!-- Local dev configs hold the Calibrator connection string. Gitignored, but the Web SDK
       copies appsettings*.json into the publish output by default, which would carry them onto
       the deployment server. In Production the secrets come from machine-scope environment
       variables instead. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="MsgReader" Version="6.1.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <!-- REQUIRED. Do not remove on NuGet's advice.
         NuGet raises NU1510 saying this package "is likely unnecessary" because the TYPE
         CodePagesEncodingProvider resolves from the net10 reference assemblies. It compiles
         without the package and then throws at run time:
             System.NotSupportedException: No data is available for encoding 1252
         The encoding DATA ships in this package, not in the shared framework. Verified by
         removing it and watching MsgEncodingTests / HebrewTextRepairTests fail (31/08/2026).
         Priority's .msg files are Windows-1255, so without this every Hebrew mail fails to
         open - all ten samples in the MBA-930 spike did. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Silences NU1510 for the reference above, which is deliberate. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

</Project>
