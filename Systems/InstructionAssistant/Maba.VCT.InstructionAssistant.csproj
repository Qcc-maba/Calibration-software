<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Maba.VCT.InstructionAssistant</RootNamespace>
    <AssemblyName>Maba.VCT.InstructionAssistant</AssemblyName>
    <!-- Standalone net10 web service the .NET 4.8 VCT server calls over HTTP.
         Same deployment pattern as Maba.VCT.Priority. -->
  </PropertyGroup>

  <!-- Local dev configs hold real secrets (the Priority connection string). They are gitignored,
       but the Web SDK also copies appsettings*.json into the publish output by default, which
       would carry those secrets onto the deployment server. In Production the secrets come from
       machine-scope environment variables instead — see
       scripts/Install-InstructionAssistant-Service.ps1. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

  <!-- PDF / Word / OCR extraction packages are added once the real network file formats
       are confirmed (see PLAN.md §"מה עדיין נדרש ממך"). Until then extraction of those
       formats returns a clear "unsupported" note rather than a hard dependency. -->

</Project>
