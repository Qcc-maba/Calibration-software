                            $scope.calture = data.systemCultureCodeModel;
                            $scope.timeZone = data.systemTimeZoneModel;
                            $scope.temperatureUnit = data.systemTemperaturUnitModel;
                            reloadUser();
                        });
                };
                //********************************************************************************
                $scope.chooseCalture = function(cl) {
                    $scope.ExtraDetails.calture = cl.displayName;
                    $scope.ExtraDetails.cultureCode = cl.cultureCode;
                    if (cl.cultureCode == 'He-Iljjjj') {
                    
                        $translate.use(cl.cultureCode);
                        tmhDynamicLocale.set(cl.cultureCode);
                    }else{
                     
                        $translate.use('en');
                        tmhDynamicLocale.set('en');
                      
                    }
