                //*********************************************************************************
                $scope.chooseTimeZone= function(tz) {
                    $scope.ExtraDetails.timeZone = "UTC - " + tz.actualOffset / 60 + " " + tz.displayName;
                    $scope.ExtraDetails.zoneID = tz.zoneID;
                }
                //*********************************************************************************
                $scope.chooseTemperatureUnit = function (tu) {
                    $scope.ExtraDetails.temperatureUnit = tu.displayName;
                    $scope.ExtraDetails.typeUnitID = tu.typeUnitID;
                }
                //********************************************************************************
                function checkUserExtraDetails(userDetails) {
                    for (var i = 0; i < $scope.calture.length; i++) {
                        if ($scope.calture[i].cultureCode == userDetails.cultureCode) {
                            $scope.ExtraDetails.calture = $scope.calture[i].displayName;
                            $scope.ExtraDetails.cultureCode = $scope.calture[i].cultureCode;
                            break;
                        }
